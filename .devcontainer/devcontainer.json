{
  "name": "effect-connect",
  // The tag equals the catalog's `vite-plus` pin.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0",
  // Pinned: an unpinned feature resolves `latest` through the rate-limited GitHub API.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "2.89.0" },
    "ghcr.io/devcontainers-extra/features/ripgrep:1": { "version": "15.2.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-connect"
}
