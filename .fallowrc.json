{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/resend/src/index.ts",
    "packages/alchemy-cloudflare/src/index.ts",
    "packages/*/tests/**/*.test.ts",
    "tests/dist-consumer/src/*.ts",
    "tests/workerd/src/*.ts",
    "tests/workerd/origin.js",
    "**/vite.config.ts",
    "vite.package.ts"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "packages/*/docs/**",
    "tests/workerd/.build/**"
  ],
  "ignoreDependencies": [
    "@thomasfosterau/effect-connect",
    "@thomasfosterau/effect-connect-resend",
    "@thomasfosterau/effect-connect-alchemy-cloudflare",
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "workerd",
    "@changesets/changelog-github",
    "@effect/docgen",
    "tsx",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/**"]
      },
      {
        "name": "resend",
        "patterns": ["packages/resend/**"]
      },
      {
        "name": "alchemy-cloudflare",
        "patterns": ["packages/alchemy-cloudflare/src/**"]
      },
      {
        "name": "alchemy-cloudflare-tests",
        "patterns": ["packages/alchemy-cloudflare/tests/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      },
      {
        "name": "workerd",
        "patterns": ["tests/workerd/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "resend",
        "allow": ["core"]
      },
      {
        "from": "alchemy-cloudflare",
        "allow": []
      },
      {
        "from": "alchemy-cloudflare-tests",
        "allow": ["alchemy-cloudflare", "resend"]
      },
      {
        "from": "dist-consumer",
        "allow": ["core", "resend", "alchemy-cloudflare"]
      },
      {
        "from": "workerd",
        "allow": ["core", "resend"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
