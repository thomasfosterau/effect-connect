{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-connect-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/effect-connect and its Resend and Twilio providers: an Effect-native messaging abstraction over email, SMS, WhatsApp and chat.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-connect": "workspace:*",
    "@thomasfosterau/effect-connect-alchemy-cloudflare": "workspace:*",
    "@thomasfosterau/effect-connect-resend": "workspace:*",
    "@thomasfosterau/effect-connect-twilio": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@11.18.0"
}
