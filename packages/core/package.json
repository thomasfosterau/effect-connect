{
  "name": "@thomasfosterau/effect-connect",
  "version": "0.3.0",
  "description": "An Effect-native messaging abstraction: per-channel message schemas, the EmailService, SmsService, WhatsAppService and ChatService contracts and their errors, provider-agnostic — the Resend email provider ships as a sibling package.",
  "keywords": [
    "effect",
    "email",
    "transactional",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-connect#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-connect/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-connect.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Chat": "./src/Chat.ts",
    "./ChatService": "./src/ChatService.ts",
    "./Email": "./src/Email.ts",
    "./EmailService": "./src/EmailService.ts",
    "./Errors": "./src/Errors.ts",
    "./Http": "./src/Http.ts",
    "./Sms": "./src/Sms.ts",
    "./SmsService": "./src/SmsService.ts",
    "./Transport": "./src/Transport.ts",
    "./WhatsApp": "./src/WhatsApp.ts",
    "./WhatsAppService": "./src/WhatsAppService.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Chat": {
        "types": "./dist/Chat.d.ts",
        "default": "./dist/Chat.js"
      },
      "./ChatService": {
        "types": "./dist/ChatService.d.ts",
        "default": "./dist/ChatService.js"
      },
      "./Email": {
        "types": "./dist/Email.d.ts",
        "default": "./dist/Email.js"
      },
      "./EmailService": {
        "types": "./dist/EmailService.d.ts",
        "default": "./dist/EmailService.js"
      },
      "./Errors": {
        "types": "./dist/Errors.d.ts",
        "default": "./dist/Errors.js"
      },
      "./Http": {
        "types": "./dist/Http.d.ts",
        "default": "./dist/Http.js"
      },
      "./Sms": {
        "types": "./dist/Sms.d.ts",
        "default": "./dist/Sms.js"
      },
      "./SmsService": {
        "types": "./dist/SmsService.d.ts",
        "default": "./dist/SmsService.js"
      },
      "./Transport": {
        "types": "./dist/Transport.d.ts",
        "default": "./dist/Transport.js"
      },
      "./WhatsApp": {
        "types": "./dist/WhatsApp.d.ts",
        "default": "./dist/WhatsApp.js"
      },
      "./WhatsAppService": {
        "types": "./dist/WhatsAppService.d.ts",
        "default": "./dist/WhatsAppService.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
